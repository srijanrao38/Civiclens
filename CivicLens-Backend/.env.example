SECRET_KEY=replace_with_django_secret_key
JWT_SIGNING_KEY=replace_with_jwt_signing_key
DEBUG=False

DB_NAME=your_database_name
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# Production only. When DATABASE_URL is set, the DB_* values above are ignored.
# DATABASE_URL=postgres://user:password@host:5432/database_name

# Required in production for report photos. Without all three, local
# development saves photos to media/ and production rejects uploads.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional, comma-separated. Render's own hostname is added automatically.
# ALLOWED_HOSTS=api.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# Optional, only used when DEBUG=False.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
